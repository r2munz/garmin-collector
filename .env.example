GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password

# Local `pdm run collect` paths (Docker overrides OUTPUT_DIR / TOKEN_DIR in docker-compose.yml)
OUTPUT_DIR=./data
TOKEN_DIR=./tokens

# Optional: override sync dates for local runs or Docker (defaults in docker-compose.yml)
# SYNC_LOOKBACK_DAYS=7
# SYNC_START=2025-01-01
# SYNC_END=2025-10-21

# Optional: push monthly Markdown to Open WebUI knowledge (vector/RAG) after each collect
# OPENWEBUI_BASE_URL=http://localhost:3000
# OPENWEBUI_API_KEY=your-api-key-from-settings-account
# OPENWEBUI_KNOWLEDGE_ID=your-knowledge-base-id
# OPENWEBUI_SYNC_ENABLED=true
# OPENWEBUI_KB_SUBDIR=true
# When true (default if KNOWLEDGE_ID is set), files go to OUTPUT_DIR/<OPENWEBUI_KNOWLEDGE_ID>/
# OPENWEBUI_KB_FOLDER=Activities
# Folder inside the knowledge base (name must match Open WebUI exactly)
# OPENWEBUI_KB_DIRECTORY_ID=optional-uuid-if-auto-resolve-fails
# OPENWEBUI_PROCESS_TIMEOUT_SEC=300
# OPENWEBUI_SYNC_CLEANUP=false
# If true, also deletes other remote KB files not in the local manifest (e.g. athlete profile docs).
# Superseded activities_YYYY-MM.md copies are replaced only for months uploaded this run.
# OPENWEBUI_SYNC_ALL=false
# If true, upload every monthly file Open WebUI diff marks added/modified (one-time KB backfill).
