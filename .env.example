GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password

# Local `pdm run collect` paths (Docker overrides OUTPUT_DIR / TOKEN_DIR in docker-compose.yml)
OUTPUT_DIR=./data
TOKEN_DIR=./tokens

# Optional: override sync dates for local runs or Docker (defaults in docker-compose.yml)
# SYNC_LOOKBACK_DAYS=7
# SYNC_START=2025-01-01
# SYNC_END=2025-10-21
